# Mercado Libre (create app at https://developers.mercadolibre.com.ar)
MELI_CLIENT_ID=
MELI_CLIENT_SECRET=
MELI_REDIRECT_URI=http://localhost:8000/auth/callback
MELI_ACCESS_TOKEN=
MELI_REFRESH_TOKEN=
MELI_SITE_ID=MLA

# LLM provider: anthropic | openai | groq | mock
# mock = datos reales de MeLi + reporte plantilla (sin gastar créditos)
LLM_PROVIDER=mock

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Groq (gratis / barato para desarrollo)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_BASE_URL=https://api.groq.com/openai/v1

# App
APP_ENV=development
LOG_LEVEL=INFO
